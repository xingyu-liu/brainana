# Version control
.git
.github
.gitignore
.gitattributes

# Python artifacts
.venv
venv/
list/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.egg-info/
dist/
build/
.eggs/

# Local dev clones / venvs (not used by Dockerfile; can be hundreds of MB)
.fireants-src/
.rtd-venv/

# Development
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE
.vscode/
.idea/
**/*.swp
**/*.swo
**/*~

# Jupyter
**/.ipynb_checkpoints/
**/*.ipynb

# Testing (not needed in runtime image)
tests/

# Examples / tutorials (not needed in runtime image)
examples/

# Dev / scratch scripts (repo-root scripts/; pipeline uses src/**/nextflow_scripts/)
scripts/

# Internal planning docs (tracked in git; not used at runtime)
docs_temp/

# Documentation (not needed in runtime image)
docs/
*.md
!README.md

# CI / publishing config
.readthedocs.yaml

# Docker metadata (keep docker/files/ — FreeSurfer slim install stage copies freesurfer-exclude.txt)
Dockerfile*
docker/*
!docker/files/
!docker/files/**
docker-compose*.yml
.dockerignore

# Nextflow work directories and local binary
work/
nextflow
.nextflow/
.nextflow.log*
null/

# Secrets / local licenses (never ship in image)
.env
.env.*
license.txt

# Misc
**/.db
**/.DS_Store
**/Thumbs.db
**/*.log
**/*.tmp
**/*.bak
